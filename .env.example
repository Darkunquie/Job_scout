# Copy to .env (or paste into Coolify's environment tab) and fill in. Never commit the real .env.
# Generate secrets with:  openssl rand -hex 32
# Use hex (letters+digits) for POSTGRES_PASSWORD: it goes inside a URL.
POSTGRES_PASSWORD=
JWT_SECRET=
ADMIN_EMAIL=admin@yourdomain.com
# Min 12 chars. Only used to create the first admin on an empty database.
ADMIN_PASSWORD=

PUBLIC_URL=https://jobs.yourdomain.com
# Set 0 only while testing over plain http://IP before HTTPS is on.
COOKIE_SECURE=1
WEB_PORT=3000

LLM_MODEL=qwen2.5:3b
# 0 switches the local AI off; scraping keeps working.
LLM_ENABLED=1
